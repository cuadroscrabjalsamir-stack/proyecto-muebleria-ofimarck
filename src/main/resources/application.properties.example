# application.properties.example
# Copia este archivo a application.properties y ajusta las credenciales

server.port=8080
spring.application.name=sistema-muebleria-ofimarck

# Base de datos PostgreSQL
spring.datasource.url=jdbc:postgresql://localhost:5432/sistema_muebleria?currentSchema=muebleria,public
spring.datasource.username=postgres
spring.datasource.password=123
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate (none porque Flyway maneja el schema)
spring.jpa.hibernate.ddl-auto=none
spring.jpa.properties.hibernate.default_schema=muebleria
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=true

# Flyway migraciones
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.schemas=muebleria
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1

# Thymeleaf
spring.thymeleaf.cache=false
spring.thymeleaf.prefix=classpath:/templates/
spring.thymeleaf.suffix=.html
spring.thymeleaf.mode=HTML
spring.thymeleaf.encoding=UTF-8

# Formato JSON
spring.jackson.time-zone=America/Lima
spring.jackson.date-format=yyyy-MM-dd HH:mm:ss
spring.jackson.serialization.fail-on-empty-beans=false

# Sesión y cookies seguras
server.servlet.session.cookie.http-only=true
server.servlet.session.cookie.same-site=Lax
server.servlet.session.timeout=1800

# Email para restablecimiento de contraseña (configurar en entorno de producción)
spring.mail.host=${MAIL_HOST:}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USER:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=${MAIL_SMTP_AUTH:false}
spring.mail.properties.mail.smtp.starttls.enable=${MAIL_STARTTLS_ENABLE:true}
spring.mail.test-connection=false
app.mail.from=noreply@ofimarck.pe
